server.max-http-request-header-size=100KB
spring.jpa.properties.hibernate.dialect=ca.uhn.fhir.jpa.model.dialect.HapiFhirPostgresDialect
spring.datasource.driverClassName=org.postgresql.Driver
hapi.fhir.use_apache_address_strategy=true
hapi.fhir.use_apache_address_strategy_https=true
hapi.fhir.logicalUrls=http://terminology.hl7.org/*,https://terminology.hl7.org/*,http://snomed.info/*,https://snomed.info/*,http://unitsofmeasure.org/*,https://unitsofmeasure.org/*,http://loinc.org/*,https://loinc.org/*,http://midas.iisc.ac.in/*,https://midas.iisc.ac.in/*
hapi.fhir.ig_runtime_upload_enabled=true
hapi.fhir.cr.enabled=true
hapi.fhir.subscription.resthook_enabled=true
hapi.fhir.binary_storage_enabled=true
hapi.fhir.binary_storage=Minio
hapi.fhir.binary_storage_minio.base_path=binary
hapi.fhir.binary_storage_minio.base_url=http://minio.minio.svc.cluster.local:9000
hapi.fhir.binary_storage_minio.bucket_name=arogyam-fhir
hapi.fhir.binary_storage_minio.access_key=CHANGE_ME
hapi.fhir.binary_storage_minio.secret_key=CHANGE_ME
hapi.fhir.security.inbound.authentication.enabled=true
hapi.fhir.security.inbound.authentication.user-realm-uri=https://site.example.org/auth/realms/arogyam
hapi.fhir.security.inbound.authorization.enabled=true
hapi.fhir.bulk_export_enabled=true

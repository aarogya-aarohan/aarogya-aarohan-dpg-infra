# Environment variables read by scripts/ (scripts/lib/common.sh).
# Export them in your shell before running a script; values below are examples.
# Each script also accepts --base-url, which overrides the *_BASE_URL variable.

# Public base URL of each environment (no trailing slash)
export STAGING_BASE_URL=https://staging.example.org
export PRODUCTION_BASE_URL=https://example.org

# Cloud project that holds the secret store (GCP reference implementation)
export GCP_PROJECT_ID=my-gcp-project

# Optional: reach the ingress through a port-forward instead of the public load
# balancer (useful from inside a private network). Same format as curl --connect-to.
export CURL_CONNECT_TO=

# Optional: skip TLS verification (local clusters with self-signed certificates only)
export CURL_INSECURE=

# Optional: parallel workers for FHIR imports during tenant migration
export IMPORT_PARALLELISM=

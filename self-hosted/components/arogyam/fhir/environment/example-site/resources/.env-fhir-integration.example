PORT=3000

FHIR_BASE_URL=http://arogyam-fhir.production.svc.cluster.local/fhir
FHIR_TOKEN_URL=CHANGE_ME
FHIR_CLIENT_ID=api-client
FHIR_CLIENT_SECRET=CHANGE_ME

DIAGNOSIS_ENABLED=true
DIAGNOSIS_QUESTIONNAIRE_REFERENCE=Questionnaire/OralCancerScreenPatient
DIAGNOSIS_TASK_INSTANTIATE_CANONICAL=https://midas.iisc.ac.in/fhir/ActivityDefinition/oral-cancer-screen-patient
DIAGNOSIS_TASK_FOLLOW_UP_URI=https://midas.iisc.ac.in/fhir/Task/oral-cancer-screening-follow-up
DIAGNOSIS_PER_CRON_ENCOUNTER=500
DIAGNOSIS_CRON_LOCK_MINUTES=30

EXPORT_ENABLED=false
EXPORT_SITE_ID=example-site
EXPORT_FHIR_URL=https://central.example.org/fhir
EXPORT_TOKEN_URL=CHANGE_ME
EXPORT_CLIENT_ID=import-client-example-site
EXPORT_CLIENT_SECRET=CHANGE_ME
EXPORT_PER_CRON_ENCOUNTER=1
EXPORT_CRON_LOCK_MINUTES=5

READER_ENABLED=false
READER_PER_CRON_MEDIA=100
READER_CRON_LOCK_MINUTES=30
READER_TASK_INTERVAL_DAYS=1

UPLOAD_STATUS_ENABLED=true
UPLOAD_STATUS_CRON_LOCK_MINUTES=2880
UPLOAD_STATUS_APPLY=true

DIAGNOSIS_NON_SUSP_PERCENT=5
DIAGNOSIS_NON_SUSPICIOUS_CRON_LOCK_MINUTES=480
DIAGNOSIS_NON_SUSPICIOUS_MIN_ENCOUNTER_AGE_HOURS=24
DIAGNOSIS_NON_SUSPICIOUS_DAILY_CRON_EXPRESSION=30 13 * * *

DIAGNOSIS_SPECIALIST_CRON_LOCK_MINUTES=480
DIAGNOSIS_SPECIALIST_TASK_LIMIT=25
DIAGNOSIS_SPECIALIST_DAILY_CRON_EXPRESSION=30 13 * * *
DIAGNOSIS_SPECIALIST_SOURCE_TASK_ID_EXTENSION_URL=http://midas.iisc.ac.in/diagnosis-specialist-source-task-id
DIAGNOSIS_SPECIALIST_REVIEW_QUESTIONNAIRE_REFERENCE=Questionnaire/OralCancerReviewPatient
DIAGNOSIS_SPECIALIST_REVIEW_TASK_INSTANTIATE_CANONICAL=https://midas.iisc.ac.in/fhir/ActivityDefinition/oral-cancer-review-patient

# Keep TLS verification on in production (1). 0 disables it.
NODE_TLS_REJECT_UNAUTHORIZED=1
